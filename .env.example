# ==============================================================================
# EduMastermind Web - Environment Configuration Example
# Copy this file to .env to configure local builds or container runtimes:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# DOCKER & CONTAINER PORT MAPPINGS
# ------------------------------------------------------------------------------
# Host port mapped to Nginx port 80 in production Docker Compose
HOST_PORT=8080

# Host port mapped to Vite dev server in development Docker Compose
DEV_PORT=5173

# ------------------------------------------------------------------------------
# VITE BUILD-TIME ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# CRITICAL NOTICE REGARDING VITE CLIENT-SIDE ENVIRONMENT VARIABLES:
# Variables prefixed with 'VITE_' are embedded into the client-side JavaScript
# bundle DURING THE BUILD STEP ('npm run build' / Docker builder stage).
# Modifying .env at runtime on a running production Nginx container will NOT
# update compiled JavaScript assets without triggering a rebuild:
#   docker compose up -d --build
# ------------------------------------------------------------------------------

# Application environment tag (development, staging, production)
VITE_APP_ENV=production

# Application UI Title
VITE_APP_TITLE=EduMastermind Learning Platform

# Base URL for external REST/GraphQL API endpoints
VITE_API_BASE_URL=https://api.edumastermind.internal/v1

# Feature toggles
VITE_FEATURE_MASTERY_ARENA=true
VITE_FEATURE_SPACED_REPETITION=true
VITE_FEATURE_ANALYTICS=true

# ------------------------------------------------------------------------------
# RUNTIME PUBLIC CONFIGURATION (SAFE DYNAMIC CONFIGURATION)
# ------------------------------------------------------------------------------
# For configurations that MUST change dynamically at container boot time without
# rebuilding the image, use the window.__EDU_CONFIG__ mechanism in index.html or
# inject a config.js file via Nginx sub_filter / volume mount.
# ------------------------------------------------------------------------------

# AI Studio / Cloud Run Injection (automatically provided in AI Studio platform)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
