# ==============================================================================
# EduMastermind Web - Development Dockerfile
# Optimized for local development with hot reload and fast rebuilds
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

# Copy package manifests first to leverage layer caching
COPY package.json package-lock.json* ./

# Install dependencies (including devDependencies)
RUN if [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Copy remaining source code
COPY . .

# Expose Vite development server port
EXPOSE 5173

# Start Vite dev server bound to all interfaces for container networking
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
